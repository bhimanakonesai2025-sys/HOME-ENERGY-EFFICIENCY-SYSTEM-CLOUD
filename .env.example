# ==========================================
# ENERGYFLOW CONFIGURATION
# ==========================================

PORT=5000

# Change this before deployment.
JWT_SECRET=energyflow_change_this_secret

# Electricity cost used for dashboard estimate.
COST_PER_KWH=8

# ------------------------------------------
# STORAGE
# ------------------------------------------
# Keep "local" while testing on your laptop.
# Later change to "dynamodb" on the cloud VM.

STORAGE_MODE=local

# ------------------------------------------
# AWS
# ------------------------------------------

AWS_REGION=ap-south-1

# ------------------------------------------
# DATA INGESTION SECURITY
# ------------------------------------------

INGEST_API_KEY=energyflow_change_this_key

# ------------------------------------------
# APPLICATION
# ------------------------------------------

NODE_ENV=development

PUBLIC_BASE_URL=http://localhost:5000